#!/bin/bash
# Set up various environments

source ~/.environments.locale
source ~/.environments.bash-completion
source ~/.environments.bat
source ~/.environments.golang
source ~/.environments.homebrew
source ~/.environments.perlbrew
source ~/.environments.pipenv
source ~/.environments.pyenv
source ~/.environments.rust
source ~/.environments.rvm
source ~/.environments.ssh_agent
source ~/.environments.starship
source ~/.environments.tag
